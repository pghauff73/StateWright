{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ourd/egcf-v1/workflow.schema.json",
  "title": "EGCFv1 Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "description", "parameters", "nodes", "outputs"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "parameters": {"type": "object"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "command_id", "inputs"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "command_id": {"type": "string", "minLength": 1},
          "inputs": {"type": "object"},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "when": {"type": "object"},
          "retry_limit": {"type": "integer", "minimum": 0},
          "checkpoint": {"type": "boolean"}
        }
      }
    },
    "outputs": {"type": "object"}
  }
}
