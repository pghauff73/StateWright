{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ourd/egcf-v1/command-catalog.schema.json",
  "title": "EGCFv1 Command Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "description", "namespaces"],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "namespaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    }
  }
}
