root ::= ws (message | function-call) ws
message ::= "{" ws "\"type\"" ws ":" ws "\"message\"" ws "," ws "\"content\"" ws ":" ws string ws "}"
function-call ::= "{" ws "\"type\"" ws ":" ws "\"function_call\"" ws "," ws "\"name\"" ws ":" ws string ws "," ws "\"arguments\"" ws ":" ws object ws ("," ws "\"call_id\"" ws ":" ws string ws)? "}"
object ::= "{" ws members? "}"
members ::= pair (ws "," ws pair)*
pair ::= string ws ":" ws value
value ::= object | array | string | number | "true" | "false" | "null"
array ::= "[" ws elements? "]"
elements ::= value (ws "," ws value)*
string ::= "\"" characters "\""
characters ::= character*
character ::= [^"\\\x7F\x00-\x1F] | "\\" escape
escape ::= ["\\/bfnrt] | "u" hex hex hex hex
hex ::= [0-9a-fA-F]
number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
ws ::= [ \t\n\r]*
