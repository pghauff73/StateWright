{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pghauff73.github.io/ourd-coding-agent/schemas/reasoning-benchmark-v1.json",
  "title": "OIEC-SR reasoning benchmark records",
  "$defs": {
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expected"],
      "properties": {
        "kind": {"enum": ["exact", "contains", "hypothesis_label", "component_label"]},
        "expected": {"type": "string", "minLength": 1}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "problem_id",
        "category",
        "prompt",
        "oracle",
        "oracle_method",
        "required_evidence_ids",
        "required_counterexamples",
        "source_refs"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "problem_id": {"type": "string", "minLength": 1},
        "category": {
          "enum": [
            "logic",
            "arithmetic",
            "debugging",
            "evidence_synthesis",
            "scientific_inference",
            "causal_reasoning",
            "ambiguity_resolution",
            "adversarial"
          ]
        },
        "prompt": {"type": "string", "minLength": 1},
        "oracle": {"$ref": "#/$defs/oracle"},
        "oracle_method": {"type": "string", "minLength": 1},
        "required_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_counterexamples": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "problem_id",
        "system_id",
        "answer",
        "confidence_bp",
        "evidence_ids",
        "counterexamples",
        "token_count",
        "tool_calls",
        "collisions",
        "retries",
        "wall_time_ms",
        "terminal_state"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "problem_id": {"type": "string", "minLength": 1},
        "system_id": {"enum": ["base", "oiec", "oiec_sr"]},
        "answer": {"type": "string"},
        "confidence_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "counterexamples": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "token_count": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "collisions": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "terminal_state": {
          "enum": [
            "ANSWER",
            "EPISTEMIC_STOP",
            "INSUFFICIENT_EVIDENCE",
            "GOVERNANCE_STOP",
            "COMPUTE_BUDGET_EXHAUSTED",
            "NO_SURVIVING_HYPOTHESIS"
          ]
        },
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "fixture_id", "qualification_status", "observations"],
      "properties": {
        "schema_version": {"const": 1},
        "fixture_id": {"type": "string", "minLength": 1},
        "qualification_status": {"const": "development_fixture_only"},
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/observation"}
        }
      }
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "provider_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider",
        "endpoint_type",
        "base_url",
        "status",
        "model",
        "model_digest",
        "model_family",
        "parameter_size",
        "quantization_level",
        "model_size_bytes",
        "model_info_hash",
        "reasoning_effort",
        "context_budget_tokens",
        "max_output_tokens",
        "timeout_ms",
        "max_transport_retries",
        "max_reasoning_samples",
        "decoding",
        "seed",
        "signature"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "provider": {"type": "string", "minLength": 1},
        "endpoint_type": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "minLength": 1},
        "status": {"const": "ready"},
        "model": {"type": "string", "minLength": 1},
        "model_digest": {"type": "string", "minLength": 1},
        "model_family": {"type": "string"},
        "parameter_size": {"type": "string"},
        "quantization_level": {"type": "string"},
        "model_size_bytes": {"type": "integer", "minimum": 0},
        "model_info_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "context_budget_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "max_transport_retries": {"const": 0},
        "max_reasoning_samples": {"type": "integer", "minimum": 1},
        "decoding": {"type": "string", "minLength": 1},
        "seed": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runtime_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "platform_system",
        "kernel_release",
        "architecture",
        "python_version",
        "cpu_model",
        "logical_cpu_count",
        "memory_bytes",
        "gpu_name",
        "gpu_uuid",
        "gpu_driver",
        "gpu_memory_bytes",
        "accelerator_allocation",
        "runtime_context_tokens",
        "clock_source",
        "signature"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "platform_system": {"type": "string", "minLength": 1},
        "kernel_release": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "cpu_model": {"type": "string", "minLength": 1},
        "logical_cpu_count": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "gpu_name": {"type": "string"},
        "gpu_uuid": {"type": "string"},
        "gpu_driver": {"type": "string"},
        "gpu_memory_bytes": {"type": "integer", "minimum": 0},
        "accelerator_allocation": {"type": "string"},
        "runtime_context_tokens": {"type": "integer", "minimum": 0},
        "clock_source": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "provider_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_calls",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "provider_failures",
        "response_hashes",
        "runtime_observation_hashes",
        "observed_temperatures",
        "observed_top_p",
        "nondeterminism_status"
      ],
      "properties": {
        "provider_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "provider_failures": {"type": "integer", "minimum": 0},
        "response_hashes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "runtime_observation_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "observed_temperatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "observed_top_p": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "nondeterminism_status": {
          "const": "single_run_not_reproducibility_evidence"
        },
        "certificate_signatures": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^$|^[0-9a-f]{64}$"
          }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "executor",
        "provider",
        "model",
        "reasoning_effort",
        "context_budget_tokens",
        "max_output_tokens",
        "decoding"
      ],
      "properties": {
        "system_id": {"enum": ["base", "oiec", "oiec_sr"]},
        "executor": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string"},
        "context_budget_tokens": {"type": "integer", "minimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 0},
        "decoding": {"type": "string", "minLength": 1},
        "pipeline": {"type": "string", "minLength": 1},
        "source_snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_template_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_context_mode": {"type": "string", "minLength": 1},
        "provider_binding": {"$ref": "#/$defs/provider_binding"},
        "runtime_environment": {"$ref": "#/$defs/runtime_environment"},
        "telemetry": {"$ref": "#/$defs/provider_telemetry"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_id",
        "category",
        "system_id",
        "task_signature",
        "observation_signature",
        "answer",
        "correctness_bp",
        "evidence_coverage_bp",
        "counterexample_detection_bp",
        "calibration_error_bp",
        "token_count",
        "tool_calls",
        "collisions",
        "retries",
        "wall_time_ms",
        "terminal_state",
        "signature"
      ],
      "properties": {
        "problem_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "system_id": {"enum": ["base", "oiec", "oiec_sr"]},
        "task_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observation_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "answer": {"type": "string"},
        "correctness_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
        "evidence_coverage_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
        "counterexample_detection_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
        "calibration_error_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
        "token_count": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "collisions": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "terminal_state": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "problem_count",
        "accuracy_bp",
        "evidence_coverage_bp",
        "counterexample_detection_bp",
        "mean_calibration_error_bp",
        "total_tokens",
        "total_tool_calls",
        "total_collisions",
        "total_retries",
        "total_wall_time_ms",
        "signature"
      ],
      "properties": {
        "system_id": {"enum": ["base", "oiec", "oiec_sr"]},
        "problem_count": {"type": "integer", "minimum": 1},
        "accuracy_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
        "evidence_coverage_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
        "counterexample_detection_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
        "mean_calibration_error_bp": {"type": "integer", "minimum": 0, "maximum": 10000},
        "total_tokens": {"type": "integer", "minimum": 0},
        "total_tool_calls": {"type": "integer", "minimum": 0},
        "total_collisions": {"type": "integer", "minimum": 0},
        "total_retries": {"type": "integer", "minimum": 0},
        "total_wall_time_ms": {"type": "integer", "minimum": 0},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "benchmark_id",
        "generated_on",
        "execution_mode",
        "qualification_status",
        "performance_claim_allowed",
        "package_version",
        "git_head",
        "worktree_dirty",
        "source_manifest_hash",
        "source_files",
        "task_count",
        "systems",
        "results",
        "summaries",
        "signature"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "benchmark_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generated_on": {"type": "string", "format": "date"},
        "execution_mode": {"enum": ["deterministic_fixture", "provider_bound"]},
        "qualification_status": {
          "enum": [
            "development_fixture_only",
            "development_model_plumbing_only",
            "held_out_model_qualification_candidate"
          ]
        },
        "performance_claim_allowed": {"const": false},
        "package_version": {"type": "string", "minLength": 1},
        "git_head": {"type": "string"},
        "worktree_dirty": {"type": "boolean"},
        "source_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_files": {"type": "array", "items": {"$ref": "#/$defs/source_file"}},
        "task_count": {"type": "integer", "minimum": 1},
        "systems": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/system"}},
        "results": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/result"}},
        "summaries": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/summary"}},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
